#include "skeletyl.dtsi"

&default_transform {
    col-offset = <5>;
};

// Seeeduino XIAO RP2040 - Right side configuration
// UART: TX=GP1, RX=GP0 (swapped from left)
// Columns: GP14, GP15, GP2, GP3, GP4
// Rows: GP6, GP7, GP8, GP9

&kscan0 {
    row-gpios
        = <&xiao_d 6 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  // row0 - GP6
        , <&xiao_d 7 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  // row1 - GP7
        , <&xiao_d 8 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  // row2 - GP8
        , <&xiao_d 9 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  // row3 - GP9
        ; 
    col-gpios
        = <&xiao_d 14 (GPIO_ACTIVE_HIGH)> // col5 - GP14
        , <&xiao_d 15 (GPIO_ACTIVE_HIGH)> // col6 - GP15
        , <&xiao_d 2 (GPIO_ACTIVE_HIGH)>  // col7 - GP2
        , <&xiao_d 3 (GPIO_ACTIVE_HIGH)>  // col8 - GP3
        , <&xiao_d 4 (GPIO_ACTIVE_HIGH)>  // col9 - GP4
        ;
};

// Configure UART for wired split communication (TX=GP1, RX=GP0)
&xiao_serial {
    status = "okay";
};
