#include "skeletyl.dtsi"

&default_transform {
    col-offset = <5>;
};

// Waveshare RP2040 Zero - Right side configuration
// UART: TX=GP1, RX=GP0 (swapped from left)
// Columns: GP14, GP15, GP2, GP3, GP4
// Rows: GP6, GP7, GP8, GP9, GP10

&kscan0 {
    row-gpios
        = <&gpio0 6 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  // row0 - GP6
        , <&gpio0 7 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  // row1 - GP7
        , <&gpio0 8 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  // row2 - GP8
        , <&gpio0 9 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  // row3 - GP9
        ; 
    col-gpios
        = <&gpio0 14 (GPIO_ACTIVE_HIGH)> // col5 - GP14
        , <&gpio0 15 (GPIO_ACTIVE_HIGH)> // col6 - GP15
        , <&gpio0 2 (GPIO_ACTIVE_HIGH)>  // col7 - GP2
        , <&gpio0 3 (GPIO_ACTIVE_HIGH)>  // col8 - GP3
        , <&gpio0 4 (GPIO_ACTIVE_HIGH)>  // col9 - GP4
        ;
};

// Configure UART for wired split communication (TX=GP1, RX=GP0)
&uart0 {
    status = "okay";
    current-speed = <115200>;
    tx-pin = <1>;  // GP1
    rx-pin = <0>;  // GP0
};
